# 手动部署时复制为 .env 并填写；使用 deploy.sh 时无需本文件（脚本会自动生成 .env）
# 至少需要：UI_PASSWORD + （SQL_DSN 或 SQLITE_PATH）

# new-api 数据源（只读）
SQL_DSN=postgresql://root:123456@postgres:5432/new-api
SQLITE_PATH=
# new-api 的 SQLite 数据目录在宿主机上的路径（仅 SQLite 模式需要）
NEWAPI_DATA_HOST=

# 管理界面
UI_PASSWORD=change-me-please
UI_BIND_PORT=8080
UI_PUBLISH_PORT=8765
# 宿主机侧绑定地址：默认只绑本机，不暴露公网；要对内网开放就改成内网 IP
UI_BIND_ADDR=127.0.0.1

# 轮询与网络
POLL_INTERVAL=10s
NEWAPI_NETWORK=new-api-network
# 每日财务推送的开关和 HH:MM 在 Web 界面保存到 SQLite，无需新增环境变量
# TZ 决定服务器自然日边界及每日推送 HH:MM；日报统计该时区的昨日自然日
TZ=Asia/Shanghai
